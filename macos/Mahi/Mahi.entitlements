<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Computer use is real now: global screen capture (CGWindowList),
         Accessibility reads of other apps, and synthetic CGEvent input cannot
         work inside the App Sandbox, so it is disabled for the direct-download
         (DMG) build. This forfeits Mac App Store distribution; see
         docs/backend/domains/04-connectivity-takeover.md. Safety still holds:
         macOS TCC gates Screen Recording + Accessibility per-user, and the
         in-app supervisor (pause/kill) + sensitive-screen guard gate every
         action. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
